# ===== M1A5TO local integration (.env) =====
# Skopiuj do .env i dostosuj.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zsd2

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=rabbit_user
RABBITMQ_DEFAULT_PASS=ChangeMeRabbit!

# --- Scrapper (LIVE) ---
# compose.yml uruchamia źródła: otodom, morizon, gratka, trojmiasto w trybie LIVE
# - bez --city (czyli "cała Polska" wg logiki danego adaptera)
# - z limitem stron (--max-pages)
#
# Żeby scrapować "wszystko" (bez limitu stron), w compose.yml usuń flagę:
#   --max-pages ${SCRAPPER_MAX_PAGES}
#
# Opis CLI/flag: SCRAPPER/README.md oraz definicje komend: SCRAPPER/scrapper/cli.py
SCRAPPER_MAX_PAGES=200

# --- POI worker ---
# Pipeline zakłada, że przed uruchomieniem masz przygotowane artefakty w POI/workspace/ dla kafelków z GRID_JSON.
# Dla aktualnej konfiguracji używamy testowego gridu:
POI_GRID_JSON=data/grid_test.json

# --- FUZZY worker ---
# Domyślnie po AI: image_classification_results (AI publikuje po konsumpcji poi_results)
FUZZY_INPUT_QUEUE=image_classification_results
# score_apartments_offline.py: TIME_UNIT=seconds|minutes, ALPHA=0..1
FUZZY_TIME_UNIT=seconds
FUZZY_ALPHA=0.9

# --- Frontend (Vite) ---
# Domyślnie używamy proxy /api -> http://api:8000 (w sieci dockera), więc nie trzeba zmieniać.
# Możesz nadpisać np. VITE_API_BASE_URL=http://localhost:8081 jeśli odpalasz frontend poza dockerem.
VITE_API_BASE_URL=/api
